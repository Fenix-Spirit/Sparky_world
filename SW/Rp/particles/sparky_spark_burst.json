{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sw:spark_burst",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 36
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(4, 7)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.6)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.0,
        "linear_acceleration": [0, -2, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.18 - (v.particle_age / v.particle_lifetime) * 0.12", "0.18 - (v.particle_age / v.particle_lifetime) * 0.12"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [16, 48],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [1.0, 1.0, 0.85, 1.0],
            "0.5": [1.0, 0.85, 0.3, 1.0],
            "1.0": [0.6, 0.3, 1.0, 0.0]
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
